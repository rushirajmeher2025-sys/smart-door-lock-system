<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Left side: Tap anywhere to open the LocKify app -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_lock_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_lock_closed" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/widget_lock_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Locked"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#F2F2F3" />

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Front door"
                android:textSize="11sp"
                android:textColor="#A1A1AA" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right side: Tap button to trigger background Quick Lock -->
    <FrameLayout
        android:id="@+id/widget_lock_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_button_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock_closed"
            android:contentDescription="Lock door" />
    </FrameLayout>

</LinearLayout>
