{
  "rules": {
    "devices": {
      "$deviceId": {
        // Auto-access: Any authenticated user with the app/APK can read device state
        ".read": "auth != null",

        "status": {
          // Only the physical ESP32 device or owner can update status
          ".write": "auth != null && (auth.token.isDevice === true || root.child('devices/' + $deviceId + '/metadata/deviceUid').val() === auth.uid || root.child('devices/' + $deviceId + '/metadata/ownerUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['isLocked', 'doorClosed', 'lastUpdated'])",
          "isLocked": { ".validate": "newData.isBoolean()" },
          "doorClosed": { ".validate": "newData.isBoolean()" },
          "isOnline": { ".validate": "newData.isBoolean()" },
          "lastUpdated": { ".validate": "newData.isNumber()" },
          "lastHeartbeat": { ".validate": "newData.isNumber()" },
          "burglarAlarmActive": { ".validate": "newData.isBoolean()" },
          "isLockout": { ".validate": "newData.isBoolean()" },
          "lastMethod": { ".validate": "newData.isString()" },
          "lastProcessedCommandId": { ".validate": "newData.isString() || newData.val() == null" }
        },

        "commands": {
          "$commandId": {
            // Only the owner or approved users in authorizedUsers can create PENDING commands
            // Only device or owner can update status to EXECUTED / REJECTED
            ".write": "auth != null && (
              (!data.exists() && newData.exists() && newData.child('requestedBy').val() === auth.uid && newData.child('status').val() === 'PENDING' && (root.child('devices/' + $deviceId + '/metadata/authorizedUsers/' + auth.uid).val() === true || root.child('devices/' + $deviceId + '/metadata/ownerUid').val() === auth.uid))
              || (data.exists() && (auth.token.isDevice === true || root.child('devices/' + $deviceId + '/metadata/deviceUid').val() === auth.uid || root.child('devices/' + $deviceId + '/metadata/ownerUid').val() === auth.uid))
            )",
            ".validate": "newData.hasChildren(['action', 'commandId', 'requestedAt', 'requestedBy', 'status'])",
            "action": { ".validate": "newData.val() === 'LOCK' || newData.val() === 'UNLOCK' || newData.val() === 'CLEAR_ALARM' || newData.val() === 'PING'" },
            "commandId": { ".validate": "newData.val() === $commandId" },
            "requestedAt": { ".validate": "newData.isNumber()" },
            "requestedBy": { ".validate": "newData.val() === auth.uid || data.val() === newData.val()" },
            "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'PROCESSING' || newData.val() === 'EXECUTED' || newData.val() === 'REJECTED' || newData.val() === 'FAILED'" },
            "executedAt": { ".validate": "newData.isNumber() || newData.val() == null" },
            "failureReason": { ".validate": "newData.isString() || newData.val() == null" }
          }
        },

        "requests": {
          // Access requests from new users awaiting owner approval
          ".read": "auth != null",
          "$uid": {
            // User can submit/cancel their own request; owner can approve or decline
            ".write": "auth != null && (auth.uid === $uid || root.child('devices/' + $deviceId + '/metadata/ownerUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'email', 'requestedAt', 'status'])",
            "uid": { ".validate": "newData.val() === $uid" },
            "email": { ".validate": "newData.isString()" },
            "requestedAt": { ".validate": "newData.isNumber()" },
            "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'APPROVED' || newData.val() === 'REJECTED'" }
          }
        },

        "events": {
          // Only device can write events; authorized users can read
          ".write": "auth != null && (auth.token.isDevice === true || root.child('devices/' + $deviceId + '/metadata/deviceUid').val() === auth.uid || root.child('devices/' + $deviceId + '/metadata/ownerUid').val() === auth.uid)",
          "$eventId": {
            ".validate": "newData.hasChildren(['title', 'method', 'timestamp', 'severity'])",
            "title": { ".validate": "newData.isString() && newData.val().length > 0" },
            "description": { ".validate": "newData.isString() || newData.val() == null" },
            "method": { ".validate": "newData.isString()" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "severity": { ".validate": "newData.val() === 'normal' || newData.val() === 'warning' || newData.val() === 'alarm'" },
            "type": { ".validate": "newData.isString()" },
            "gsmAlertSent": { ".validate": "newData.isBoolean() || newData.val() == null" }
          }
        },

        "metadata": {
          // Only the owner can write metadata and manage authorized users
          ".write": "auth != null && (data.child('ownerUid').val() === auth.uid || (!data.exists() && newData.child('ownerUid').val() === auth.uid) || auth.token.admin === true)",
          "deviceId": { ".validate": "newData.val() === $deviceId" },
          "ownerUid": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          "deviceUid": { ".validate": "newData.isString() && newData.val().length > 0" },
          "deviceName": { ".validate": "newData.isString()" },
          "firmwareVersion": { ".validate": "newData.isString()" },
          "hardware": { ".validate": "newData.isString()" }
        }
      }
    },

    "users": {
      "$uid": {
        // Users can only read and write their own device index
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          "$deviceId": {
            ".validate": "newData.isBoolean() || newData.isString()"
          }
        }
      }
    }
  }
}
